{
  "schemaVersion": 1,
  "id": "development-workflow",
  "name": "软件交付 Workflow",
  "version": "1.0.0",
  "phases": [
    {
      "id": "discovery",
      "name": "想法与探索",
      "goal": "澄清目标并形成共享理解。",
      "steps": [{ "id": "discover", "name": "澄清 Idea", "kind": "skill", "skill": { "name": "grill-with-docs", "version": "1.0.0" }, "artifacts": ["domain-docs"] }]
    },
    {
      "id": "requirements",
      "name": "需求与领域文档",
      "goal": "将已确认的上下文形成可审阅规格。",
      "steps": [{ "id": "spec", "name": "形成规格", "kind": "skill", "skill": { "name": "to-spec", "version": "1.0.0" }, "artifacts": ["specification"] }]
    },
    {
      "id": "planning",
      "name": "规划",
      "goal": "将规格拆分为有依赖关系的交付切片。",
      "steps": [{ "id": "tickets", "name": "拆分 tickets", "kind": "skill", "skill": { "name": "to-tickets", "version": "1.0.0" }, "artifacts": ["tickets"], "condition": "planning.required" }]
    },
    {
      "id": "implementation",
      "name": "实现",
      "goal": "以垂直切片实现并验证变更。",
      "steps": [{ "id": "implement", "name": "实现与测试", "kind": "skill", "skill": { "name": "implement", "version": "1.0.0" }, "artifacts": ["commit"], "approvalGate": "高风险写操作确认" }]
    },
    {
      "id": "verification",
      "name": "产品验证",
      "goal": "验证所有 Implementation Ticket 集成后的完整产品。",
      "steps": [{ "id": "verify", "name": "产品级验证", "kind": "skill", "skill": { "name": "product-verification", "version": "1.0.0" }, "artifacts": ["verification-report"] }]
    },
    {
      "id": "delivery",
      "name": "提交、推送与 PR",
      "goal": "将变更交付到远程仓库。",
      "steps": [{ "id": "delivery", "name": "创建 PR", "kind": "tool", "adapter": "github.pull-request", "condition": "project.remote.present", "artifacts": ["pull-request"], "approvalGate": "PR 合并确认" }]
    },
    {
      "id": "release",
      "name": "发布",
      "goal": "按 Project 配置完成发布。",
      "steps": [
        { "id": "build", "name": "构建发布包", "kind": "tool", "adapter": "project.release", "operation": "build", "condition": "project.release.enabled" },
        { "id": "release", "name": "发布", "kind": "tool", "adapter": "project.release", "operation": "release", "condition": "project.release.enabled", "approvalGate": "发布确认" }
      ]
    },
    {
      "id": "post-release",
      "name": "发布后验证",
      "goal": "确认交付结果在目标环境可用。",
      "steps": [{ "id": "validate", "name": "上线验证", "kind": "tool", "adapter": "project.release", "operation": "validation", "condition": "project.release.enabled", "artifacts": ["validation-report"] }]
    }
  ]
}
